# copy to .env.local and fill in
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899
NEXT_PUBLIC_PROGRAM_ID=PASTE_YOUR_PROGRAM_ID
NEXT_PUBLIC_CLUSTER_LABEL=localnet

# --- optional: Supabase indexer (see supabase/migrations/0001_init.sql) ---
# Public values (safe in the browser). Use the anon key, never the service key, for the next line.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
